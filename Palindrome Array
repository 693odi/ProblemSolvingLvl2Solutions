int ReadPositiveNumber(string msg) {
    int Number ;
    do {
        cout<<msg<<'\n';
        cin>>Number;
    }while (Number <= 0);
    return Number;
}
void BuildTheArray(int arr[100], int& arrLength) {
    arrLength = ReadPositiveNumber("Enter Size of array ? ");
    for (int i = 0 ; i < arrLength; i++) {
        arr[i] = ReadPositiveNumber("");
    }
}
bool isPalindrome(int arr[100], int arrLength) {
    bool flag = true;
    for (int i = 0 ; i < arrLength ;i++) {
        if (arr[i] != arr[arrLength - 1 - i ]) {
            return flag;
        }
    }
    return flag;
}
void PrintTheArray(int arr[100], int arrLength) {
    for (int i = 0 ; i < arrLength; i++) {
        cout<<arr[i]<<" ";
    }
}

