int RandomNumber(int From , int To) {
    return rand()%(To - From + 1 ) + From;
}
enum NumberStatus{Positive = 1 , Negative = 2 };
NumberStatus Num(int Number) {
    if (Number > 0) {
        return NumberStatus::Positive;
    }else if (Number <= 0) {
        return NumberStatus::Negative;
    }
}
void BuildTheArray(int arr[100] , int& arrLength) {
    cout<<"Enter Size Of The Array ?\n";
    cin>>arrLength;
    for (int i = 0 ; i < arrLength ; i++) {
        arr[i] = RandomNumber(-100,100);
    }
}
int CounterPositiveNumbers(int arr[100] , int arrLength) {
    int Count =  0;
    for (int i = 0 ; i< arrLength ; i++) {
        if (Num(arr[i]) == NumberStatus::Positive) {
            Count ++;
        }
    }
    return Count;
}
void PrintTheArray(int arr[100], int arrLength) {
    for (int i = 0 ; i < arrLength; i++) {
        cout<<arr[i]<<" ";
    }
}


