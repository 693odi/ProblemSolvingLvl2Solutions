int ReadPositiveNumber(string msg) {
    int Number ;

    do {

        cout<<msg<<'\n';
        cin>>Number;
    }while (Number <= 0);

    return Number;
}
int GenRandomNumber(int From , int To) {
    return rand()% ( To - From + 1 ) + From;
}
string GenerateKey() {
    string key = "";
    for (int i = 0 ; i < 4 ; i++) {
        char CapitalLetter = GenRandomNumber(65,90);
        key = key + CapitalLetter;
    }
    return key;
}
string GenerateCompleteKey() {
    string Key = "";
    for (int i = 0 ; i < 4 ; i++) {
        Key = Key + GenerateKey();
        if (i < 3 ) {
            Key = Key + '-';
        }
    }
    return Key;
}
void NumberOfKeys(int NumberofKeys) {
    for (int i = 1 ; i <= NumberofKeys ; i++) {
        cout<<"Key ["<<i<<"] :"<<GenerateCompleteKey()<<'\n';
    }
}


int main() {
    srand((unsigned) time(NULL));
