int RandomNumber(int From = 1 , int To = 100 ) {
    return rand()%(To - From + 1 )+ From;
}
void MinValueInArray(int array[100] , int arrLength) {
    int MinV = array[0];
    for (int i = 1 ; i < arrLength ;i++) {
        if (array[i] < MinV) {
            MinV = array[i];
        }
    }
    cout<<"\nMax Element is : " <<MinV;
}

void FillArrayRandomly(int array[100] , int& arrLength) {
    cout <<"Enter Array Size : ";
    cin>>arrLength;
    for (int i = 0 ; i < arrLength ; i++) {
        array[i] = RandomNumber(1,100);
    }
}
void PrintArrayElements(int array[100] , int arrLength) {
    cout<<"Array Elements : ";
    for (int i = 0 ; i < arrLength ; i++) {
        cout<<array[i]<<" ";
    }
    MinValueInArray(array,arrLength);
}


