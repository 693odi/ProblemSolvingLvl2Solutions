int ReadPostiveNumber(string MSG) {
    int Number ;
    do {
        cout<<MSG<<'\n';
        cin>>Number;

    }while (Number <= 0);
    return Number;
}
enum PerfectNumber{PerfectNum = 1 , notPerfectNum = 0};
PerfectNumber Perfect(int Number) {
    int Sum = 0 ;
    for (int i = 1 ; i <= floor(Number/2) ; i++) {
        if (Number % i == 0) {
            Sum = Sum + i;
        }
    }

    if (Sum == Number) {
        return PerfectNumber::PerfectNum;
    }else {
        return PerfectNumber::notPerfectNum;
    }
}
void PrintPerfectNumber() {
    PerfectHeader();
    int Number = ReadPostiveNumber("\t\t\tEnter Positive Number: ");
    PerfectNumber perf; perf = PerfectNumber(Number);
    cout<<"\t\t\t";
    if (perf) {
        cout<<"["<<Number<<"]"<<" is perfect\n";
    }else {
        cout<<"["<<Number<<"]"<<" is not perfect\n";
    }
}

