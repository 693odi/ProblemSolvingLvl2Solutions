int RandomNumber(int From , int To) {
    return rand()% (To - From + 1 ) + From;
}

enum enmyChar{Cap = 1 , Small = 2 , Speical = 3 , Digit =4  };

char printTheCharacter(enmyChar MyChar) {
    char letter ;

    switch (MyChar) {
        case enmyChar::Cap : letter = RandomNumber(65,90); break;
        case enmyChar::Small : letter = RandomNumber(97,122);break;
        case enmyChar::Speical : letter = RandomNumber(33,47);break;
        case enmyChar::Digit : letter = RandomNumber(48,57);break;
    }

    return letter;
}

