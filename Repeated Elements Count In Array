int ReadPositiveNumber(string msg) {
    int Number ;

    do {

        cout<<msg<<'\n';
        cin>>Number;

    }while (Number < 0);

    return Number;
}
void EnterArrayElements(int array[100], int Size) {
    for (int i = 0 ; i < Size ;i++) {
        cout<<"Elements ["<<i+1<<"] :";cin>>array[i];
    }
}
void PrintArrayElements(int array[100] , int Size) {
    cout<<"Original Array: ";
    for (int i = 0 ; i < Size;i++) {
        cout<<array[i]<<" ";
    }
}
int CounterSpecificNumber(int array[100] , int Size , int Goal) {
    int Counter = 0;
    for (int i = 0 ; i < Size; i++) {
        if (array[i] == Goal)
            Counter++;
    }
    return Counter;
}
void PrintInMain() {
    int array[100];
    int Size = ReadPositiveNumber("Enter The Size Of The Array : ");
    EnterArrayElements(array,Size);
    int Goal = ReadPositiveNumber("\nEnter The number you want to check : ");
    PrintArrayElements(array,Size);
    cout<<'\n';
    cout<<Goal<<" is repeated "<<CounterSpecificNumber(array,Size,Goal)<<" Time(s)\n";
}
