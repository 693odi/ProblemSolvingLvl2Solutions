enum ElementFound{ Found = 1 , notFound = 0};
ElementFound isFound(int Number , int arr[100] , int& arrLength) {
    for (int i = 0 ; i < arrLength ; i++) {
        if (arr[i] == Number) {
            return ElementFound::Found;
        }
    }
    return ElementFound::notFound;
}
int RandomNumber(int From , int To) {
    return rand()%(To - From + 1 ) + From;
}
int ReadPosNumber() {
    int Number ;
    do {
        cout<<"Enter Positive Numbe ?";
        cin>>Number;
    }while (Number <= 0);
    return Number;
}
void BuildTheArray(int arr[100], int arrLength) {
    for (int i = 0 ; i < arrLength; i++) {
        cin>>arr[i];
    }
}
void AddArrayElement(int Number,int arr[100] , int& arrLength) {
    if (isFound(Number , arr , arrLength) == ElementFound::notFound){
        arr[arrLength++] = Number;
    }
}
void CopyDistinctNumbersToArray(int arr[100] , int arrGoal[100],int& arr1Length , int& arr2Length) {
    for (int i = 0 ; i < arr1Length ;i++) {
        AddArrayElement(arr[i], arrGoal , arr2Length);
    }
}
void PrintTheArray(int arr[100] , int& arrLength) {
    for (int i = 0 ; i < arrLength ;i++) {
        cout<<arr[i]<<" ";
    }
}

