int RandomNumber(int From = 1  , int To = 100) {
    return rand()%(To - From + 1 )+ From;
}
void FillArrayRandomly(int array [100] , int& length){
    for (int i = 0 ; i <length ;i++) {
        array[i] = RandomNumber();
    }
}
void PrintArrayElements(int array[100], int length) {
    cout<<"Array Elements : ";
    for (int i = 0 ; i < length ; i++) {
        cout<<array[i]<<" " ;
    }
}
int ReadPositiveNumber(string msg) {
    int Number ;
    do {

        cout<<msg<<'\n';
        cin>>Number;

    }while (Number <= 0);
    return Number;
}

