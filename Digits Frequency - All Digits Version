int DigitFrequency(int Number , int Digit) {
    int Count = 0;
    while (Number > 0) {
        if ((Number % 10) == Digit)
            Count++;
        Number = Number / 10;
    }
    return Count;
}

void DigitsFrequency(int Number) {
    for (int i = 0 ; i <= 9 ;i++) {
        short Counter = DigitFrequency(Number,i);
        if (Counter > 0 ) {
            cout<<"Digit "<< i <<" Frequency is : "<<Counter<<" Time(s)\n";
        }
    }

}

