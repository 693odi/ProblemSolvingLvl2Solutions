int RandomNumber(int From , int To) {
    return rand()%(To - From + 1 ) + From;
}
string SingleKey() {
    string singleKey = "";
    for (int i = 0 ; i < 4 ; i ++) {
        singleKey = singleKey + char(RandomNumber(65 , 90));
    }
    return singleKey;
}
string GenerateWholeKey() {
    string key = "";
    for (int i = 0 ; i < 4 ; i++) {
        key = key + SingleKey();
        if (i < 3) {
            key = key + '-';
        }
    }
    return key;
}
void FillArrayWithKeys(string arr[100], int& arrLength) {
    cout<<"How many keys do you want?\n";
    cin>>arrLength;
    for (int i = 0 ; i < arrLength ; i++) {
        arr[i] = GenerateWholeKey();
    }
}
void PrintTheArray(string arr[100], int arrLength) {
    for (int i = 0 ; i < arrLength ; i++) {
        cout<<"Array["<<i<<"] : "<<GenerateWholeKey()<<"\n";
    }
}


int main() {
    srand((unsigned) time(NULL));
