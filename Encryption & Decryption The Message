string ReadWord (string msg) {
    string Word ;
    cout<<msg<<endl;
    cin>>Word;

    return Word;
}

string Encryption(string Word) {

    string EncryptionWord = "";
    for (int i = 0 ; i < Word.length();i++) {
        char letter =  Word[i];
        letter = letter + 2 ;
        EncryptionWord = EncryptionWord + letter;
    }

    return EncryptionWord;
}

string Decryption(string Word) {

    string DecryptionWord = "";
    for (int i = 0 ; i < Word.length();i++) {
        char letter =  Word[i];
        letter = letter - 2 ;
        DecryptionWord = DecryptionWord + letter;
    }

    return DecryptionWord;
}





int main() {
    srand((unsigned) time(NULL));
    ios_base::sync_with_stdio(0);
    string w = ReadWord("Enter The Word : ");
    cout<<"Text Before Encryption : "<<w<<'\n';
    cout<<"Text After Encryption : "<<Encryption(w)<<'\n';
    cout<<"Text After Decryption : "<<Decryption(Encryption(w))<<'\n';

    return 0;
}
