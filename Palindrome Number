int ReadPositiveNumber(string msg) {
    int Number;
    do {

        cout<<msg<<endl;
        cin>>Number;

    }while (Number <= 0 );

    return Number;

}

int ReverseNumber(int Number) {
    int newRevNumber = 0 ;
    while ( Number > 0 ) {
        newRevNumber = ((newRevNumber*10) + (Number % 10));
        Number = Number / 10;
    }

    return newRevNumber;

}

bool isPalindrome(int firNumber , int RevFirstNumber) {
    return firNumber == RevFirstNumber;
}

void PrintAllInfo() {

    int FirstNumber = ReadPositiveNumber("Enter Positive Number : ");
