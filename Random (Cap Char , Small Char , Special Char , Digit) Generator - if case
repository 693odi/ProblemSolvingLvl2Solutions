int RandomNumber(int From , int To) {
    return rand()% (To - From + 1 ) + From;
}

enum enmyChar{Cap = 1 , Small = 2 , Speical = 3 , Digit =4  };

char printTheCharacter(enmyChar MyChar) {
    char letter ;
    
    if (enmyChar::Cap == MyChar) {
        letter = RandomNumber(65,90);
    }else if (enmyChar::Small == MyChar) {
        letter = RandomNumber(97,122);
    }else if (enmyChar::Speical == MyChar) {
        letter = RandomNumber(33,47);
    }else {
        letter = RandomNumber(48,57);
    }

    return letter;
}

