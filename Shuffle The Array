int RandomNumber(int From , int To) {
    return rand()%(To - From + 1 ) + From;
}
void BuildTheArray(int arr[100] , int& arrLength) {
    cout<<"How many elements ?\n";
    cin>>arrLength;
    for (int i = 0 ; i < arrLength ; i++) {
        arr[i] = i+1;
    }
}
void Swap(int& Number1 , int& Number2) {
    int temp = Number2;
    Number2 = Number1;
    Number1 = temp;
}
void ShuffleTheArray(int arr[100] , int arrLength) {
    for (int i = 0 ; i < arrLength ; i++) {
        Swap(arr[RandomNumber(0,arrLength - 1 )] , arr[RandomNumber(0,arrLength - 1 ) ] );
    }
}
void PrintTheArray(int arr[100] , int arrLength) {
    for (int i = 0 ; i < arrLength ; i++) {
        cout<<arr[i]<<" ";
    }
    cout<<'\n';
}


int main() {
    srand((unsigned) time(NULL));
    ios_base::sync_with_stdio(0);
    int arr[100] , arrLength;
    BuildTheArray(arr,arrLength);
    cout<<"Array Before Shuffle : \n";
    PrintTheArray(arr,arrLength);
    ShuffleTheArray(arr,arrLength);
    cout<<"Array After Shuffle : \n";
    PrintTheArray(arr,arrLength);


    return 0;
}
