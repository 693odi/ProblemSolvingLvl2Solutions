int ReadPositiveNumber(string msg) {
    int Number ;
    do {

        cout<<msg<<endl;
        cin>>Number;

    }while (Number <= 0);

    return Number;
}

void PrintNormalNumberPattern(int Number) {
    for (int i = 1 ; i <= Number ; i++) {
        for (int j = 1 ; j<= i ; j++) {
            cout<<i;
        }
        cout<<'\n';
    }
}


