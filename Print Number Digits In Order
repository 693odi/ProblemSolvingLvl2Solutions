int ReadPositiveNumber(string msg) {
    int Number ;
    do {

        cout<<msg<<endl;
        cin>>Number;

    }while (Number <= 0 );
    return Number;
}

int ReverseNumber(int Number) {

    int newRevNumber = 0 ;

    while ( Number > 0 ) {
        newRevNumber = (newRevNumber*10) + (Number %10);
        Number = Number / 10;
    }

    return newRevNumber;
}

void PrintNumberInReversedOrder(int ReveresdNumber) {

    while ( ReveresdNumber > 0 ) {
        cout<<ReveresdNumber%10;
        ReveresdNumber = ReveresdNumber / 10;
        cout<<'\n';
    }

}



