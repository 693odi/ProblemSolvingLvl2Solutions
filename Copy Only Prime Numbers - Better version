enum Primes{Prime = 1 , notPrime = 0};
Primes isPrime(int Number) {
    for (int i= 2 ; i <= round(Number / 2) ; i++) {
        if (Number % i == 0 ) {
            return Primes::notPrime;
        }
    }
    return Primes::Prime;
}
int RandomNumber(int From , int To) {
    return rand()%(To - From + 1 ) + From;
}
int ReadPosNumber() {
    int Number ;
    do {
