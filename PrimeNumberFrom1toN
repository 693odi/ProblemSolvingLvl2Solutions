bool IsPrime(int Number) {
    for (int count = 2 ; count < Number ; count++) {
        if (Number % count == 0 )return false;
    }
    return true;
}
void PrimeNumbersFrom1toN(int Number) {
    PrimeNumbersHeader();
    int count = 1;
    for (int i = 2 ; i<= Number ;i++) {
        if (IsPrime(i)) {
            cout<<"\t["<<(count)<<"] ";
            cout<<"\t\t"<<i<<"\t : Is Prime Number\n";
            count++;

        }
    }
}


