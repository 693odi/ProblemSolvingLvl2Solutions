int ReadPositiveNumber(string msg) {
    int Number ;
    do {

        cout<<msg<<endl;
        cin>>Number;

    }while (Number <= 0 );
    return Number;
}

int DigitFrequency(int Number , int Digit) {

    int Count = 0 ;
    while ( Number > 0 ) {
        if ((Number % 10) == Digit) {
            ++Count;
        }
        Number = Number / 10;
    }
    return Count;

}


