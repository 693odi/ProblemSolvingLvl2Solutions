enum isPrime{Prime = 1 , notPrime = 0};
isPrime is_Prime(int Number) {
    if (Number <= 1 ) return isPrime::notPrime;
    for (int i = 2 ; i<=round(Number/2) ; i++ ) {
        if (Number % i == 0) {
            return isPrime::notPrime;
        }
    }
    return isPrime::Prime;
}
int RandomNumber(int From , int To) {
    return rand()%(To - From + 1 ) + From;
}
void BulidTheArray(int arr[100] , int& arrLength) {
    cout << "Enter The Array Length : ";
    cin >> arrLength;
    for (int i = 0 ; i < arrLength ; i++) {
        arr[i] = RandomNumber(1,100);
    }
}
void CopyPrimeArray(int arr1[100] , int arr2[100], int& arr1Length , int& arr2Length) {
    arr2Length = 0;
    for (int i  = 0 ; i < arr1Length ; i++) {
        if (is_Prime(arr1[i]) == isPrime::Prime) {
            arr2[arr2Length] = arr1[i];
            arr2Length++;
        }
    }
}
void PrintTheArray(int arr[100] , int arrLength) {
    for (int i = 0 ; i < arrLength ; i++) {
        cout<<arr[i]<<" ";
    }
}

