char ReadPositiveNumber(string msg) {
    int Number ;
    do {

        cout<<msg<<endl;
        cin>>Number;

    }while (Number <= 0 || Number > 26);

    return (char) (Number + 64) ;
}

void PrintNormalLetterPattern(char letter) {

    for (char i = 'A' ; i <= letter ; i++) {
        for (char j = 'A' ; j <= i  ;j++ ) {
            cout<<i;
        }
        cout<<'\n';
    }

}


