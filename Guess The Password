string ReadPassword(string msg) {
    string password ;
    do {

        cout<<msg<<endl;
        cin>>password;

    }while (password.length() > 3 || password.length() < 3 || password[0] < 'A' || password[0] > 'Z' || password[1] < 'A' || password[1] > 'Z' || password[2] < 'A' || password[2] > 'Z');
    return password;
}

bool GuessThePassword(string OrignalPassword) {

    string word = "";
    int counter = 1;

    for (char fletter = 'A' ; fletter <= 'Z' ; fletter++) {
        for (char sletter = 'A' ; sletter <= 'Z' ; sletter++) {
            for (char tletter = 'A' ; tletter <= 'Z' ; tletter++) {

                word = word + fletter + sletter + tletter;

                cout<<"Trail ["<<counter<<"] : "<<word<<'\n';

                if (OrignalPassword == word) {
                    cout<<"Password is "<<word<<endl;
                    cout<<"Found after "<<counter<<" Trial(s)";
                    return true;
                }

                word = "";
                counter++;
            }
        }
    }

    cout <<OrignalPassword<<" is not found";
    return false;
}



int main() {
    srand((unsigned) time(NULL));
    ios_base::sync_with_stdio(0);

    GuessThePassword(ReadPassword("Enter The Password : "));


