int ReadPositiveNumber(string msg) {
    int Number ;
    do {

        cout<<msg<<endl;
        cin>>Number;

    }while (Number <= 0 );
    return Number;
}

int Digits_Sum(int Number) {
    int Sum = 0 ;
    while (Number > 0 ) {
        Sum = Sum + (Number % 10);
        Number = Number / 10;
    }
    return Sum;
}


