int ReadPositiveNumber(string msg) {
    int Number ;
    do {

        cout<<msg<<endl;
        cin>>Number;

    }while (Number <= 0 );
    return Number;
}

int ReverseNumber(int Number) {
    int NewRevNumber = 0;
    while (Number > 0 ) {
        NewRevNumber = (NewRevNumber*10) + (Number%10);
        Number = Number / 10;
    }
    return NewRevNumber;
}


