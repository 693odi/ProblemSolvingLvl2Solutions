float ReadNumber(string msg) {
    float Number ;
    cout<<msg<<'\n';
    cin>>Number;
    return Number;
}

float GetFraction(float Number) {
    int myNumber = Number;
    return (Number - myNumber);
}

int myRound(float Number) {
    if (Number > 0) {
        if (GetFraction(Number) >= 0.5) {
            return (int) Number + 1 ;
        }else {
            return (int) Number;
        }
    }
    if (Number < 0 ) {
        if (GetFraction(Number) <= -0.5) {
            return (int) Number - 1;
        }else {
            return (int) Number;
        }
    }
}
int main() {
    srand((unsigned) time(NULL));
    ios_base::sync_with_stdio(0);
    float Number = ReadNumber("Enter a number : ");
    cout<<"My Round Function : "<<myRound(Number)<<'\n';
    cout<<"C++ Round Function : "<<round(Number)<<'\n';


    return 0;
}
